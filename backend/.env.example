# Local development defaults. For production, set ALLOWED_ORIGINS to exact HTTPS origins.
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173

# Keep the engine unconfigured until a licensed, verified local adapter and model are installed.
ANIMATION_ENGINE=unconfigured
ANIMATION_ENGINE_ADAPTER_PATH=
ANIMATION_MODEL_MANIFEST_PATH=

# Never enable customer release merely to make readiness green.
ANIMATION_ENGINE_CUSTOMER_RELEASE_APPROVED=false
ANIMATION_ENGINE_RELEASE_APPROVAL_ID=

# Backend-only signing key; never expose through Vite.
AUTH_SIGNING_KEY=
AUTH_TOKEN_ISSUER=speedy-live-auth
AUTH_TOKEN_AUDIENCE=speedy-live-api
AUTH_DATABASE_PATH=./data/auth.sqlite3
